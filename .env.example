# ── Traccar GPS server ───────────────────────────────────────────────
TRACCAR_URL=http://your-traccar-server:8082
TRACCAR_EMAIL=admin
TRACCAR_PASSWORD=admin

# ── CrewSight / Rowing tracker (optional, for ?source=rowing) ────────
# ROWING_TRACKER_URL=https://your-crewsight-instance.vercel.app
# ROWING_INGEST_TOKEN=rnz

# ── CV Position auth (optional — open if unset) ─────────────────────
# CV_INGEST_TOKEN=some-secret

# ── Vercel KV / Redis (optional — falls back to in-memory) ──────────
# KV_REST_API_URL=https://your-kv.vercel-storage.com
# KV_REST_API_TOKEN=your-token

# ── Warning alerts / email (optional) ────────────────────────────────
# WARNING_ALERT_SECRET=some-secret
# CRON_SECRET=some-secret
# RESEND_API_KEY=re_xxxxx
# WARNING_NOTIFY_FROM=alerts@yourdomain.com
# WARNING_NOTIFY_EMAILS=recipient@example.com

# ── Trial results auth (optional — has built-in default) ─────────────
# TRIAL_RESULTS_TOKEN=r3A2xEjWMDoqeT910VtDsg

# ── Server port ──────────────────────────────────────────────────────
PORT=3000
